# Copy to .env.local and fill in values after deploying the test backend stack.
# Run: cd infrastructure/backend && make deploy-test
# API URL and Identity Pool ID are printed at the end of the deploy output under "Outputs".
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/api
VITE_IDENTITY_POOL_ID=us-east-1:<identity-pool-id>
VITE_AWS_REGION=us-east-1

# Square credentials — from developer.squareup.com
# Use sandbox-sq0idb-... for test, sq0idp-... for prod
VITE_SQUARE_APP_ID=<square-app-id>
VITE_SQUARE_LOCATION_ID=<square-location-id>

# Public S3 assets bucket — output of make deploy-test / make deploy-prod
VITE_ASSETS_BASE_URL=https://matkewaali-assets-<env>.s3.amazonaws.com
